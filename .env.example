# ============================================================
# Copy to .env for local testing. Never commit your real .env file.
# In Render, add these under Environment Variables instead.
# ============================================================

PORT=3000

# Meta webhook verification token: invent a secret string and use the SAME
# value in Meta's webhook "Verify Token" field.
META_VERIFY_TOKEN=choose_a_random_secret_string

# WhatsApp Cloud API access token.
META_ACCESS_TOKEN=EAAG...your_whatsapp_access_token

# WhatsApp -> API Setup -> Phone number ID (this is NOT the phone number itself).
WHATSAPP_PHONE_NUMBER_ID=1234567890

# Messenger Page Access Token for the Facebook Page connected to this app.
MESSENGER_PAGE_ACCESS_TOKEN=EAAG...your_messenger_page_access_token

# Keep configurable. Change this in Render when you intentionally move Graph versions.
GRAPH_API_VERSION=v21.0

# Meta App Dashboard -> Settings -> Basic -> App Secret.
# Optional during setup, strongly recommended before production.
META_APP_SECRET=your_app_secret_here

# OpenAI API
OPENAI_API_KEY=sk-...your_openai_api_key
OPENAI_MODEL=gpt-5.6-luna
OPENAI_MAX_OUTPUT_TOKENS=500

# Number of recent user/assistant messages retained in memory per chat.
MAX_HISTORY_MESSAGES=10
