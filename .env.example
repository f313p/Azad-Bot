# ============================================================
# ENVIRONMENT VARIABLES — copy this file to ".env" and fill in
# your real values. NEVER commit the real ".env" file to git.
# ============================================================

# ---- Server ----
PORT=3000

# ---- Meta (WhatsApp Cloud API + Messenger) ----
# Any string you invent yourself. You will type this SAME value
# into the "Verify Token" field in the Meta App Dashboard webhook
# configuration screen.
META_VERIFY_TOKEN=choose_a_random_secret_string

# Permanent (or temporary, while testing) access token generated
# in Meta App Dashboard -> WhatsApp -> API Setup, or via a System
# User token in Meta Business Settings for production.
META_ACCESS_TOKEN=EAAG...your_long_meta_access_token

# WhatsApp Cloud API "Phone number ID" (Meta App Dashboard -> WhatsApp -> API Setup)
WHATSAPP_PHONE_NUMBER_ID=1234567890

# Facebook Page Access Token (can be the same as META_ACCESS_TOKEN if
# you generated one token with both whatsapp + pages permissions, or
# a separate Page token from Meta App Dashboard -> Messenger -> API Setup)
MESSENGER_PAGE_ACCESS_TOKEN=EAAG...your_page_access_token

# Graph API version to call, e.g. v21.0
GRAPH_API_VERSION=v21.0

# App Secret (Meta App Dashboard -> Settings -> Basic -> App Secret).
# Used to verify that incoming webhook requests really came from Meta.
# Strongly recommended for production; the app still runs without it
# but logs a warning and skips verification.
META_APP_SECRET=your_app_secret_here

# ---- AI (Anthropic Claude API) ----
ANTHROPIC_API_KEY=sk-ant-api03-...your_key
CLAUDE_MODEL=claude-sonnet-4-5

# ---- Optional ----
# Max characters kept in the short in-memory conversation history per user
MAX_HISTORY_MESSAGES=10
